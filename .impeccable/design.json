 "narrative": {
  "northStar": "La scuola, in una card",
  "overview": "The direction comes from three references the user chose (a dark biotech site, a light AI-health site, a dark IT-services site), translated into the institute's palette and Raleway. Content lives in large rounded containers: the home hero is a rounded card holding the real footage, light sections are white panels inset into a deep-navy canvas, figures and photos sit in a bento of tiles. Type is light and large, in sentence case, with one phrase emphasised. Glass is used only where something floats over imagery: the navigation pill, the stat cards on the hero, the chips on photos.\n\nInterior pages (courses, news, documents) are light: white ground with a soft blue glow at the top, the same pills, radii and type.",
  "keyCharacteristics": [
   "Deep-navy canvas made of tones of the institutional blue; white panels inset by 8–16px with 40px corners.",
   "Raleway 300 display, sentence case, one phrase at 600 in cyan (dark) or electric blue (light).",
   "Glass pills and cards over footage and photos.",
   "Bento tiles: a CTA tile, stat tiles (label + number), photo tiles, a list tile, one gradient accent tile.",
   "Pill buttons; the arrow icon rotates to ↗ on hover.",
   "Photo cards with a bottom scrim, a glass area chip and a white circular arrow."
  ],
  "rules": [
   {
    "name": "The Institute Colours Only Rule",
    "body": "Blues, cyan and their tones only. No yellow, green, red or category colours; areas are named, not coloured.",
    "section": "colors"
   },
   {
    "name": "The Readable Gradient Rule",
    "body": "White text sits only on the darker part of the institutional gradients; the cyan end never carries small white text.",
    "section": "colors"
   },
   {
    "name": "The Light Display Rule",
    "body": "Headlines are light (300) and in sentence case; weight is spent on one phrase only.",
    "section": "typography"
   },
   {
    "name": "The No Kicker Rule",
    "body": "No badge or label above a headline. Pills and chips go on imagery, beside actions, or after the title.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do keep content in rounded containers and inset panels.",
   "Do set headlines light, in sentence case, with one emphasised phrase.",
   "Do use glass only over imagery.",
   "Do keep every action a pill with a verb, and the ↗ arrow on primary actions.",
   "Do use real photography; photos under 1200px stay in tiles and cards, never full width."
  ],
  "donts": [
   "Don't add yellow, green, red or per-area colours.",
   "Don't put a badge or label above a headline.",
   "Don't bring back mono micro-labels, counters, grid backgrounds or HUD frames.",
   "Don't put small white text on the cyan end of a gradient.",
   "Don't invent figures, testimonials or partners; published figures live in the Customizer."
  ]
 }
}