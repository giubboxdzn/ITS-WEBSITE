 "narrative": {
  "northStar": "Lo stesso Rossellini, più adulto",
  "overview": "The system keeps what makes the current itsrossellini.it recognisable and removes what makes it read as machine-made. Kept: the institutional blues with cyan, Raleway set heavy and uppercase with a second line in italic, the real hero video, real photography, rounded course cards, pill buttons, the news list with large titles, partner logos in tiles. Removed: monospace micro-labels, section counters, kickers, grid-line backgrounds, glows, outlined giant numbers, the \"REC\" camera frame, coloured stripes, the marquee, 9–10px text.\n\nModern here means restraint and confidence rather than effects: big real footage, big type, generous space, few colours used as whole fields, one accent. Motion is the video itself; the interface only settles the header and lifts cards on hover.",
  "keyCharacteristics": [
   "Institutional palette only: blue, deep blue, cyan, electric blue (hover and focus), near-black, white, a cool light grey.",
   "Raleway everywhere; headlines in 900 caps with an italic 500 second line.",
   "Real footage and photographs in 14px rounded frames.",
   "Pill buttons in sentence case; circular arrow buttons on list rows.",
   "Fields of colour by section: video, light grey, white, deep blue, white, light grey, cyan, near-black."
  ],
  "rules": [
   {
    "name": "The Institute Colours Only Rule",
    "body": "No hue outside the palette: no yellow, green, red or category colours. Technological areas are told apart by name, not by colour.",
    "section": "colors"
   },
   {
    "name": "The One Accent Rule",
    "body": "Cyan is the only accent. It is a fill or large text, never small text on light grounds.",
    "section": "colors"
   },
   {
    "name": "The Two-Voice Headline Rule",
    "body": "A section headline is heavy caps, optionally followed by one italic line in the accent colour. Never a third voice, never a label above it.",
    "section": "typography"
   },
   {
    "name": "The Tracking Floor Rule",
    "body": "Letter-spacing never tighter than −0.04em, whatever the current site does.",
    "section": "typography"
   }
  ],
  "dos": [
   "Do keep the current site's voice: heavy caps headline with an italic second line.",
   "Do use only the institutional palette, with cyan as the single accent.",
   "Do show real footage and real photographs, rounded at 14px.",
   "Do keep every action a pill with a verb.",
   "Do keep content visible without JavaScript and without scrolling animations."
  ],
  "donts": [
   "Don't add yellow, green, red or per-area colours.",
   "Don't bring back monospace micro-labels, \"01 / 05\" counters, kickers, grid backgrounds, glows, outlined numbers, camera frames, coloured card stripes or the marquee.",
   "Don't set text below 13px.",
   "Don't put cyan text on white.",
   "Don't invent figures, testimonials or partners; published figures live in the Customizer."
  ]
 }
}